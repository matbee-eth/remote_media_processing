# Simple RemoteMedia Remote Execution Service for RunPod
# Optimized for smaller size and faster startup

FROM python:3.11-slim

# Install system dependencies
RUN apt-get update && apt-get install -y \
    build-essential \
    pkg-config \
    procps \
    bubblewrap \
    && rm -rf /var/lib/apt/lists/* \
    && apt-get clean

# Set working directory
WORKDIR /app

# Copy requirements and install Python dependencies
COPY remote_service/requirements.txt .
COPY requirements-ml.txt .
RUN pip install --no-cache-dir -r requirements.txt
RUN pip install --no-cache-dir -r requirements-ml.txt

# Copy and install the RemoteMedia SDK
COPY remotemedia/ /app/remotemedia/
COPY setup.py /app/setup.py
COPY pyproject.toml /app/pyproject.toml
COPY README.md /app/README.md
COPY requirements.txt /app/requirements.txt

# Install remotemedia package
RUN pip install --no-cache-dir /app/

# Verify installation
RUN python -c "import remotemedia; print('RemoteMedia SDK installed successfully')"

# Copy proto files and generate gRPC code
COPY remote_service/protos/ ./protos/
RUN python -m grpc_tools.protoc \
    --proto_path=protos \
    --python_out=. \
    --grpc_python_out=. \
    protos/*.proto

# Copy application source code
COPY remote_service/src/ ./src/
COPY remote_service/config/ ./config/

# Create directories
RUN mkdir -p /app/sandbox /app/logs

# Set environment variables
ENV PYTHONUNBUFFERED=1
ENV PYTHONDONTWRITEBYTECODE=1
ENV GRPC_PORT=50051
ENV LOG_LEVEL=INFO
ENV MAX_WORKERS=4
ENV SANDBOX_ENABLED=true
ENV SANDBOX_TYPE=bubblewrap

# Expose gRPC port
EXPOSE 50051

# Health check
HEALTHCHECK --interval=30s --timeout=10s --start-period=5s --retries=3 \
    CMD python /app/src/health_check.py || exit 1

# Start the service
CMD ["python", "/app/src/server.py"]